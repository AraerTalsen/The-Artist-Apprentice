MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b05875697436d4c6ba294074e4b9a851, type: 3}
  m_Name: NPCHelpfulDialogue1
  m_EditorClassIdentifier: 
  dialogueInfo:
  - myVoice: {fileID: 0}
    myText: Hey there! Nice to see a humanoid face around here! Things have been
      a real mess recently...
  - myVoice: {fileID: 0}
    myText: Do you by any chance know the Master?? He used to come in here and keep
      the painting clean, but I haven't seen him...
  - myVoice: {fileID: 0}
    myText: Can you do me a favor and get rid of the ink splotches? They're causing
      all kinds of problems around here.
  - myVoice: {fileID: 0}
    myText: Here, take this! I've seen the Master use them to help clean before!
  - myVoice: {fileID: 0}
    myText: To use them, open up your inventory with TAB and add them to an open
      combat slot! Good luck!
